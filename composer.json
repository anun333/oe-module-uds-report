{
    "name": "anun333/oe-module-uds-report",
    "description": "HRSA Uniform Data System (UDS) report for OpenEMR: Patients by ZIP Code and Tables 3A, 3B and 4, with a list of record problems to fix before submission",
    "type": "openemr-module",
    "license": "GPL-3.0-or-later",
    "keywords": [
        "openemr",
        "openemr-module",
        "uds",
        "hrsa",
        "fqhc",
        "health-center"
    ],
    "authors": [
        {
            "name": "anun333",
            "email": "anun333@posteo.net"
        }
    ],
    "require": {
        "php": ">=8.2",
        "openemr/oe-module-installer-plugin": "^0.1.5",
        "anun333/openhealthcare-common": "^1.4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "OpenEMR\\Modules\\UdsReport\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenEMR\\Modules\\UdsReport\\Tests\\": "tests/"
        },
        "files": [
            "tests/stubs.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "openemr/oe-module-installer-plugin": true
        }
    },
    "support": {
        "issues": "https://github.com/anun333/oe-module-uds-report/issues",
        "source": "https://github.com/anun333/oe-module-uds-report"
    },
    "extra": {
        "openhealthcare": {
            "footprint-not-covered": [
                "Whether the permission checks above behave correctly for restricted users. The end-to-end check refuses a clinician the settings page; the other pages are not yet checked with a restricted login.",
                "Whether the counting rules match the UDS Manual. The conformance cases in `data/cases/` and `tests/` cover that, and real-world validation against a health center's filed report is still to come."
            ],
            "guide-labels-elsewhere": {
                "Housing Status (UDS)": "sql/install.sql",
                "Agricultural Worker (UDS)": "sql/install.sql",
                "Military Service (UDS)": "sql/install.sql"
            }
        }
    }
}
